# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@host/dbname

# Auth.js (required)
NEXTAUTH_SECRET=        # Generate with: openssl rand -base64 32
AUTH_TRUST_HOST=true

# Foundation Models Server
AI_SERVER_URL=http://localhost:11434

# Apple OAuth (optional — sign-in button hidden when not set)
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=
# NEXT_PUBLIC_AUTH_APPLE_ENABLED=true

# AWS SES Email (optional — emails skipped gracefully when not set)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-2
# SES_FROM_EMAIL=you@yourdomain.com
