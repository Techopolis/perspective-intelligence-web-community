#!/usr/bin/env bash
# pw - PerspectiveWeb Developer CLI
# Usage: ./pw [command]
# Run without arguments for interactive menu.

set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$PROJECT_DIR"

# ── Colors ──────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# ── Helpers ─────────────────────────────────────────────
info()  { echo -e "${GREEN}$1${NC}"; }
warn()  { echo -e "${YELLOW}$1${NC}"; }
err()   { echo -e "${RED}$1${NC}" >&2; }
label() { echo -e "${CYAN}${BOLD}$1${NC}"; }

require_cmd() {
    if ! command -v "$1" &>/dev/null; then
        err "Required command not found: $1"
        err "Install it and try again."
        exit 1
    fi
}

load_env() {
    if [ -f "$PROJECT_DIR/.env" ]; then
        set -a
        source "$PROJECT_DIR/.env"
        set +a
    fi
}

# ── Commands ────────────────────────────────────────────

cmd_dev() {
    label "Starting dev server with hot reload..."
    require_cmd watchexec
    load_env

    LOCAL_IP=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo "localhost")
    info "Building project..."
    swift build

    info "Local:   http://localhost:8080"
    info "Network: http://${LOCAL_IP}:8080"
    warn "Watching Sources/, Resources/, Public/ for changes"
    warn "Press Ctrl+C to stop"
    echo ""

    watchexec \
        --restart \
        --stop-signal SIGTERM \
        --debounce 500 \
        -e swift,leaf,css,js,html \
        -w Sources \
        -w Resources \
        -w Public \
        -- swift run PerspectiveWeb serve --hostname 0.0.0.0 --port 8080
}

cmd_build() {
    label "Building PerspectiveWeb..."
    swift build
    info "Build succeeded."
}

cmd_run() {
    label "Running PerspectiveWeb server..."
    load_env
    swift run PerspectiveWeb serve --hostname 0.0.0.0 --port 8080
}

cmd_test() {
    label "Running tests..."
    swift test
}

cmd_clean() {
    label "Cleaning build artifacts..."
    swift package clean
    info "Clean complete."
}

cmd_db_start() {
    label "Starting PostgreSQL via Docker..."
    require_cmd docker
    docker compose up -d db
    info "PostgreSQL is running on localhost:5432"
}

cmd_db_stop() {
    label "Stopping PostgreSQL..."
    require_cmd docker
    docker compose stop db
    info "PostgreSQL stopped."
}

cmd_db_migrate() {
    label "Running database migrations..."
    load_env
    swift run PerspectiveWeb migrate --yes
    info "Migrations complete."
}

cmd_db_revert() {
    label "Reverting last migration..."
    load_env
    swift run PerspectiveWeb migrate --revert --yes
    info "Revert complete."
}

cmd_docker_build() {
    label "Building Docker image..."
    require_cmd docker
    docker compose build app
    info "Docker image built."
}

cmd_docker_up() {
    label "Starting full Docker stack..."
    require_cmd docker
    docker compose up -d app
    info "Stack is running. App at http://localhost:8080"
}

cmd_docker_down() {
    label "Stopping Docker stack..."
    require_cmd docker
    docker compose down
    info "Stack stopped."
}

cmd_env_setup() {
    if [ -f "$PROJECT_DIR/.env" ]; then
        warn ".env already exists. Overwrite? (y/N)"
        read -r answer
        if [[ "$answer" != "y" && "$answer" != "Y" ]]; then
            info "Skipped."
            return
        fi
    fi
    if [ -f "$PROJECT_DIR/env.example" ]; then
        cp "$PROJECT_DIR/env.example" "$PROJECT_DIR/.env"
        info "Created .env from env.example"
        warn "Edit .env to set your credentials."
    else
        err "env.example not found."
        exit 1
    fi
}

cmd_status() {
    label "Project Status"
    echo ""

    # Git branch
    echo -e "${BOLD}Git:${NC} $(git branch --show-current 2>/dev/null || echo 'not a git repo')"

    # Uncommitted changes
    CHANGES=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    if [ "$CHANGES" -gt 0 ]; then
        warn "  $CHANGES uncommitted change(s)"
    else
        info "  Working tree clean"
    fi
    echo ""

    # .env check
    if [ -f "$PROJECT_DIR/.env" ]; then
        info "Env: .env file present"
    else
        warn "Env: .env file missing (run: ./pw env:setup)"
    fi

    # Docker / DB check
    if command -v docker &>/dev/null; then
        DB_RUNNING=$(docker compose ps --status running db 2>/dev/null | grep -c "db" || true)
        if [ "$DB_RUNNING" -gt 0 ]; then
            info "DB:  PostgreSQL running (Docker)"
        else
            warn "DB:  PostgreSQL not running (run: ./pw db:start)"
        fi
    else
        warn "DB:  Docker not installed"
    fi
    echo ""
}

# ── Interactive Menu ────────────────────────────────────

show_menu() {
    echo ""
    label "PerspectiveWeb Dev CLI"
    echo -e "${DIM}Select a command:${NC}"
    echo ""
    echo "  1) dev           Start dev server with hot reload"
    echo "  2) build         Build the project"
    echo "  3) run           Run server (no hot reload)"
    echo "  4) test          Run tests"
    echo "  5) clean         Clean build artifacts"
    echo "  6) db:start      Start PostgreSQL (Docker)"
    echo "  7) db:stop       Stop PostgreSQL"
    echo "  8) db:migrate    Run database migrations"
    echo "  9) db:revert     Revert last migration"
    echo " 10) docker:build  Build Docker image"
    echo " 11) docker:up     Start full Docker stack"
    echo " 12) docker:down   Stop Docker stack"
    echo " 13) env:setup     Create .env from template"
    echo " 14) status        Show project status"
    echo "  0) exit"
    echo ""
    echo -n "Enter choice: "
}

run_menu() {
    while true; do
        show_menu
        read -r choice
        echo ""
        case "$choice" in
            1|dev)           cmd_dev; break ;;
            2|build)         cmd_build ;;
            3|run)           cmd_run; break ;;
            4|test)          cmd_test ;;
            5|clean)         cmd_clean ;;
            6|db:start)      cmd_db_start ;;
            7|db:stop)       cmd_db_stop ;;
            8|db:migrate)    cmd_db_migrate ;;
            9|db:revert)     cmd_db_revert ;;
            10|docker:build) cmd_docker_build ;;
            11|docker:up)    cmd_docker_up ;;
            12|docker:down)  cmd_docker_down ;;
            13|env:setup)    cmd_env_setup ;;
            14|status)       cmd_status ;;
            0|exit|q)        info "Bye."; exit 0 ;;
            *)               err "Invalid choice: $choice" ;;
        esac
    done
}

# ── Dispatch ────────────────────────────────────────────

show_help() {
    echo ""
    label "PerspectiveWeb Dev CLI"
    echo ""
    echo "Usage: ./pw [command]"
    echo ""
    echo "Commands:"
    echo "  dev           Start dev server with hot reload"
    echo "  build         Build the project"
    echo "  run           Run server (no hot reload)"
    echo "  test          Run tests"
    echo "  clean         Clean build artifacts"
    echo "  db:start      Start PostgreSQL (Docker)"
    echo "  db:stop       Stop PostgreSQL"
    echo "  db:migrate    Run database migrations"
    echo "  db:revert     Revert last migration"
    echo "  docker:build  Build Docker image"
    echo "  docker:up     Start full Docker stack"
    echo "  docker:down   Stop Docker stack"
    echo "  env:setup     Create .env from template"
    echo "  status        Show project status"
    echo "  help          Show this help"
    echo ""
    echo "Run without arguments for interactive menu."
    echo ""
}

if [ $# -eq 0 ]; then
    run_menu
    exit 0
fi

case "$1" in
    dev)           cmd_dev ;;
    build)         cmd_build ;;
    run)           cmd_run ;;
    test)          cmd_test ;;
    clean)         cmd_clean ;;
    db:start)      cmd_db_start ;;
    db:stop)       cmd_db_stop ;;
    db:migrate)    cmd_db_migrate ;;
    db:revert)     cmd_db_revert ;;
    docker:build)  cmd_docker_build ;;
    docker:up)     cmd_docker_up ;;
    docker:down)   cmd_docker_down ;;
    env:setup)     cmd_env_setup ;;
    status)        cmd_status ;;
    help|--help|-h) show_help ;;
    *)
        err "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
