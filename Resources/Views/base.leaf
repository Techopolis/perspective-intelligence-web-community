<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perspective Web - Foundation Models Interface</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="stylesheet" href="/css/imessage.css">
    <link rel="stylesheet" href="/css/helpbot.css?v=2">
</head>
<body>
    <div class="app-container">
        #import("content")
    </div>
    <!-- Help Chatbot -->
    <button type="button" class="help-fab" id="helpBtn" aria-label="Get help with Techopolis" aria-expanded="false" aria-haspopup="dialog">
        Get Help
    </button>

    <dialog id="helpDialog" class="help-modal" aria-labelledby="helpDialogTitle" aria-modal="true">
        <div class="help-modal-inner">
            <header class="help-modal-header">
                <h2 id="helpDialogTitle">Techopolis Help</h2>
                <button type="button" class="btn-close" id="helpClose" aria-label="Close help">
                    <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 6L6 18M6 6l12 12"/>
                    </svg>
                </button>
            </header>
            <div class="help-messages" id="helpMessages" role="log" aria-live="off" aria-label="Help conversation">
            </div>
            <form class="help-form" id="helpForm" aria-label="Ask a question">
                <label for="helpInput" class="visually-hidden">Type your question</label>
                <input type="text" id="helpInput" class="help-input" placeholder="Ask about Techopolis..." autocomplete="off">
                <button type="submit" class="btn btn-send help-send" id="helpSend" aria-label="Send question">
                    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
                    </svg>
                </button>
            </form>
            <div class="visually-hidden" id="helpAnnouncer" role="status" aria-atomic="true"></div>
        </div>
    </dialog>

    <script src="https://cdn.jsdelivr.net/npm/marked@15/marked.min.js"></script>
    <script src="/js/helpbot.js?v=2"></script>
    #if(includeChat):
    <script src="/js/chat.js"></script>
    #endif
</body>
</html>

