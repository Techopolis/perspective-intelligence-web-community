#extend("base"):
    #export("content"):
    <nav class="sidebar" role="navigation" aria-label="Chat history">
        <div class="sidebar-header">
            <h1 class="logo">Perspective Web</h1>
            <button type="button" class="btn btn-primary new-chat-btn" id="newChatBtn" aria-label="Start new chat">
                New Chat
            </button>
        </div>
        <div class="chat-list" id="chatList" role="list" aria-label="Previous conversations">
        </div>
        <div class="sidebar-footer">
            <div class="user-info">
                <span class="user-name">#(userName)</span>
                <a href="/logout" class="btn btn-secondary btn-sm" aria-label="Sign out">Sign Out</a>
            </div>
            <div class="server-status" id="serverStatus">
                <span class="status-indicator" aria-hidden="true"></span>
                <span class="status-text">Checking server...</span>
            </div>
        </div>
    </nav>
    
    <main class="chat-main" role="main">
        <header class="chat-header">
            <h2 class="chat-title" id="chatTitle">Select or start a new chat</h2>
        </header>
        
        <div class="messages-container" id="messagesContainer" aria-label="Chat messages">
        <div class="welcome-message" id="welcomeMessage">
            <div class="welcome-content">
                <h2>Welcome to Perspective Web</h2>
                <p>Your private interface for Apple Foundation Models.</p>
                <p>Start a new conversation or select an existing one from the sidebar.</p>
            </div>
        </div>
        </div>
        
        <form class="message-form" id="messageForm" aria-label="Send a message">
            <div class="input-wrapper">
                <label for="messageInput" class="visually-hidden">Type your message</label>
                <textarea 
                    id="messageInput" 
                    class="message-input" 
                    placeholder="Type your message..."
                    rows="1"
                    disabled
                    aria-describedby="inputHint"
                ></textarea>
                <span id="inputHint" class="visually-hidden">Press Enter to send, Shift+Enter for new line</span>
                <button type="submit" class="btn btn-send" id="sendBtn" disabled aria-label="Send message">
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
                    </svg>
                </button>
            </div>
        </form>
        
        <div class="status-announcer visually-hidden" id="statusAnnouncer" role="status" aria-live="assertive"></div>
    </main>
    
    <dialog id="deleteChatDialog" class="modal" aria-labelledby="deleteDialogTitle">
        <button type="button" class="btn-close" id="closeDeleteDialog" aria-label="Close dialog">
            <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 6L6 18M6 6l12 12"/>
            </svg>
        </button>
        <h2 id="deleteDialogTitle">Delete Chat</h2>
        <p>Are you sure you want to delete this chat? This action cannot be undone.</p>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" id="cancelDeleteBtn">Cancel</button>
            <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
        </div>
    </dialog>
    
    <script>
        window.initialChatID = #if(chatID): "#(chatID)" #else: null #endif;
    </script>
    #endexport
#endextend
