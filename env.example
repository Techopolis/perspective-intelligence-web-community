# Perspective Web Environment Configuration
# Copy this file to .env and fill in your values

# Auth0 Configuration
# Get these from your Auth0 dashboard: https://manage.auth0.com
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_CALLBACK_URL=http://localhost:8080/auth/callback
AUTH0_LOGOUT_URL=http://localhost:8080

# Foundation Models Server
# URL of your Mac server running the Foundation Models API
# If using Tailscale, use your Tailscale hostname or IP
FOUNDATION_MODELS_URL=http://localhost:8081

# Optional: Database configuration
# Default uses SQLite at ./db.sqlite
# DATABASE_URL=postgres://user:pass@host:5432/perspective

# Optional: Server configuration
# PORT=8080
# HOST=0.0.0.0

